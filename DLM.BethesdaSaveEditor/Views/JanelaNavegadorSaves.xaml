<Window x:Class="DLM.BethesdaSaveEditor.Views.JanelaNavegadorSaves"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DLM.BethesdaSaveEditor.Core"
        Title="{Binding [BrowserTitle], Source={x:Static core:LocalizationService.Instance}}"
        Height="560"
        Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding [LblFolder], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <ComboBox x:Name="CmbPastas" Grid.Column="1" IsEditable="True" Margin="0,0,8,0" SelectionChanged="CmbPastas_SelectionChanged" />
            <Button Grid.Column="2" Content="{Binding [BtnBrowse], Source={x:Static core:LocalizationService.Instance}}" Style="{DynamicResource BotaoPrimario}" Click="BtnEscolherPasta_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DgSaves" Grid.Column="0" SelectionChanged="DgSaves_SelectionChanged" MouseDoubleClick="DgSaves_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Character" Binding="{Binding Personagem}" Width="140" />
                    <DataGridTextColumn Header="Lv" Binding="{Binding Nivel}" Width="50" />
                    <DataGridTextColumn Header="Location" Binding="{Binding Localizacao}" Width="*" />
                    <DataGridTextColumn Header="Game" Binding="{Binding Jogo}" Width="150" />
                    <DataGridTextColumn Header="Size" Binding="{Binding TamanhoMB}" Width="80" />
                    <DataGridTextColumn Header="Date" Binding="{Binding DataModificacao, StringFormat=yyyy-MM-dd HH:mm}" Width="125" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource CartaoResumo}" Margin="0">
                <StackPanel>
                    <Border Height="155" Background="#111827" Margin="0,0,0,8">
                        <Image x:Name="ImgPreview" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="TxtArquivo" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="TxtDetalhes" Foreground="{StaticResource FrontTextoSuave}" TextWrapping="Wrap" FontSize="11.5" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource FrontTextoSuave}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [BtnCancel], Source={x:Static core:LocalizationService.Instance}}" Style="{DynamicResource BotaoPrimario}" Width="90" IsCancel="True" />
                <Button Content="{Binding [BtnOpenSave], Source={x:Static core:LocalizationService.Instance}}" Width="110" IsDefault="True" Click="BtnAbrir_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
