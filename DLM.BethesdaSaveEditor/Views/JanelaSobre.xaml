<Window x:Class="DLM.BethesdaSaveEditor.Views.JanelaSobre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DLM.BethesdaSaveEditor.Core"
        Title="{Binding [AboutTitle], Source={x:Static core:LocalizationService.Instance}}"
        Height="430"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="DLM.BethesdaSaveEditor" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CorPrincipal}" />
            <TextBlock Text="{Binding [AboutSubtitle], Source={x:Static core:LocalizationService.Instance}}"
                       Foreground="{StaticResource FrontTextoSuave}"
                       Margin="0,2,0,12" />

            <Border Style="{StaticResource CartaoResumo}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding [AboutDevLabel], Source={x:Static core:LocalizationService.Instance}}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FrontTextoSuave}" />
                    <TextBlock Text="xaotix" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CorPrincipal}" Margin="0,3,0,4" />
                    <TextBlock Margin="0,2,0,0">
                        <Run Text="Download Latest Release: " />
                        <Hyperlink NavigateUri="https://github.com/xaotix/DLM.BethesdaSaveEditor/releases/latest" RequestNavigate="Hyperlink_RequestNavigate">
                            github.com/xaotix/DLM.BethesdaSaveEditor/releases
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0">
                        <Run Text="GitHub Repository: " />
                        <Hyperlink NavigateUri="https://github.com/xaotix/DLM.BethesdaSaveEditor" RequestNavigate="Hyperlink_RequestNavigate">
                            github.com/xaotix/DLM.BethesdaSaveEditor
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CartaoResumo}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding [AboutOrigLabel], Source={x:Static core:LocalizationService.Instance}}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource FrontTextoSuave}" />
                    <TextBlock Text="{Binding [AboutOrigText], Source={x:Static core:LocalizationService.Instance}}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,4" />
                    <TextBlock>
                        <Run Text="Original Project (FallrimTools / ReSaver): " />
                        <Hyperlink NavigateUri="https://github.com/MarkDF/FallrimTools" RequestNavigate="Hyperlink_RequestNavigate">
                            github.com/MarkDF/FallrimTools
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding [AboutDesc], Source={x:Static core:LocalizationService.Instance}}"
                       TextWrapping="Wrap"
                       FontSize="11.5"
                       Foreground="{StaticResource FrontTextoSuave}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [BtnClose], Source={x:Static core:LocalizationService.Instance}}"
                    Width="95"
                    IsDefault="True"
                    IsCancel="True"
                    Click="BtnFechar_Click" />
        </StackPanel>
    </Grid>
</Window>
