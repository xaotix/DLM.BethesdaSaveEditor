<Window x:Class="DLM.BethesdaSaveEditor.Views.JanelaEditarCabecalho"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DLM.BethesdaSaveEditor.Core"
        Title="{Binding [HeaderTitle], Source={x:Static core:LocalizationService.Instance}}"
        Height="430"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="{Binding [HeaderTabGeneral], Source={x:Static core:LocalizationService.Instance}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [LblCharacter], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtNome" Grid.Row="0" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [LblLevel], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtNivel" Grid.Row="1" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [LblSaveNumber], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtNumeroSave" Grid.Row="2" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [LblLocation], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtLocalizacao" Grid.Row="3" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [LblRace], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtRaca" Grid.Row="4" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding [LblGender], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox x:Name="CmbGenero" Grid.Row="5" Grid.Column="1" Margin="0,3">
                        <ComboBoxItem Content="Male" Tag="0" />
                        <ComboBoxItem Content="Female" Tag="1" />
                    </ComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [LblCurrentXp], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtXpAtual" Grid.Row="6" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding [LblNeededXp], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="TxtXpNecessario" Grid.Row="7" Grid.Column="1" Margin="0,3" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding [LblCompression], Source={x:Static core:LocalizationService.Instance}}" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox x:Name="CmbCompressao" Grid.Row="8" Grid.Column="1" Margin="0,3" />
                </Grid>
            </TabItem>

            <TabItem x:Name="TabCoords" Header="{Binding [HeaderTabCoords], Source={x:Static core:LocalizationService.Instance}}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pos X:" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox x:Name="TxtPosX" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pos Y:" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox x:Name="TxtPosY" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pos Z:" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox x:Name="TxtPosZ" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Cell X:" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox x:Name="TxtCellX" Grid.Row="3" Grid.Column="1" Margin="0,4" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Cell Y:" VerticalAlignment="Center" Margin="0,6" />
                    <TextBox x:Name="TxtCellY" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [BtnCancel], Source={x:Static core:LocalizationService.Instance}}"
                    Style="{DynamicResource BotaoPrimario}"
                    Width="90"
                    IsCancel="True" />
            <Button Content="{Binding [BtnConfirm], Source={x:Static core:LocalizationService.Instance}}"
                    Width="100"
                    IsDefault="True"
                    Click="BtnConfirmar_Click" />
        </StackPanel>
    </Grid>
</Window>
