<Window x:Class="DLM.BethesdaSaveEditor.Views.JanelaEditarChangeFlags"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DLM.BethesdaSaveEditor.Core"
        Title="{Binding [FlagsTitle], Source={x:Static core:LocalizationService.Instance}}"
        Height="290"
        Width="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [FlagsMask], Source={x:Static core:LocalizationService.Instance}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0" />
            <TextBox x:Name="TxtHex" Width="130" HorizontalAlignment="Left" FontFamily="Consolas" TextChanged="TxtHex_TextChanged" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CartaoResumo}" Margin="0">
            <UniformGrid x:Name="GridBits" Rows="4" Columns="8" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding [BtnCancel], Source={x:Static core:LocalizationService.Instance}}"
                    Style="{DynamicResource BotaoPrimario}"
                    Width="90"
                    IsCancel="True" />
            <Button Content="{Binding [BtnConfirm], Source={x:Static core:LocalizationService.Instance}}"
                    Width="100"
                    IsDefault="True"
                    Click="BtnConfirmar_Click" />
        </StackPanel>
    </Grid>
</Window>

